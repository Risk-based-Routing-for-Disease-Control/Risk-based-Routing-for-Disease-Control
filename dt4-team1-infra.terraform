terraform {
  required_providers {
    azurerm = {
      source  = "azurerm"
      version = "4.66.0"
    }
  }
}
provider "azurerm" {
  features {}
}


data "azurerm_client_config" "current" {}

variable "logic_app_webhook_url" {
  description = "Signed Logic App webhook URL. Supply through a non-committed tfvars file or TF_VAR_logic_app_webhook_url."
  type        = string
  sensitive   = true
}

variable "office365_connection_display_name" {
  description = "Office 365 connection display name, usually the connected account email."
  type        = string
  sensitive   = true
}

variable "teams_connection_display_name" {
  description = "Microsoft Teams connection display name, usually the connected account email."
  type        = string
  sensitive   = true
}

variable "teams_channel_id" {
  description = "Target Microsoft Teams channel ID."
  type        = string
  sensitive   = true
}

variable "postgres_firewall_ip_1" {
  description = "PostgreSQL firewall IP address #1."
  type        = string
  sensitive   = true
}

variable "postgres_firewall_ip_2" {
  description = "PostgreSQL firewall IP address #2."
  type        = string
  sensitive   = true
}

variable "postgres_firewall_ip_3" {
  description = "PostgreSQL firewall IP address #3."
  type        = string
  sensitive   = true
}

variable "postgres_firewall_ip_4" {
  description = "PostgreSQL firewall IP address #4."
  type        = string
  sensitive   = true
}

variable "postgres_firewall_ip_5" {
  description = "PostgreSQL firewall IP address #5."
  type        = string
  sensitive   = true
}

variable "postgres_firewall_ip_6" {
  description = "PostgreSQL firewall IP address #6."
  type        = string
  sensitive   = true
}

variable "postgres_firewall_ip_7" {
  description = "PostgreSQL firewall IP address #7."
  type        = string
  sensitive   = true
}

variable "postgres_firewall_ip_8" {
  description = "PostgreSQL firewall IP address #8."
  type        = string
  sensitive   = true
}

variable "postgres_firewall_ip_9" {
  description = "PostgreSQL firewall IP address #9."
  type        = string
  sensitive   = true
}

variable "postgres_firewall_ip_10" {
  description = "PostgreSQL firewall IP address #10."
  type        = string
  sensitive   = true
}
resource "azurerm_monitor_action_group" "res-0" {
  enabled             = true
  location            = "global"
  name                = "collector"
  resource_group_name = azurerm_resource_group.res-1.name
  short_name          = "파이프라인 - 수집"
  tags                = {}
  webhook_receiver {
    name                    = "webhook"
    service_uri             = var.logic_app_webhook_url
    use_common_alert_schema = true
  }
}
resource "azurerm_resource_group" "res-1" {
  location   = "koreacentral"
  managed_by = ""
  name       = "dt4_project2_team1"
  tags       = {}
}
resource "azurerm_postgresql_flexible_server" "res-2" {
  administrator_login               = "azureuser"
  administrator_password            = "" # Masked sensitive attribute
  administrator_password_wo_version = 0
  auto_grow_enabled                 = false
  backup_retention_days             = 8
  delegated_subnet_id               = ""
  geo_redundant_backup_enabled      = false
  location                          = "koreacentral"
  name                              = "dt4-postgresql"
  point_in_time_restore_time_in_utc = ""
  private_dns_zone_id               = ""
  public_network_access_enabled     = true
  replication_role                  = ""
  resource_group_name               = azurerm_resource_group.res-1.name
  sku_name                          = "B_Standard_B2s"
  source_server_id                  = ""
  storage_mb                        = 32768
  storage_tier                      = "P4"
  tags                              = {}
  version                           = "16"
  zone                              = "1"
  authentication {
    active_directory_auth_enabled = false
    password_auth_enabled         = true
    tenant_id                     = ""
  }
}
